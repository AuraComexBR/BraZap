# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / WhatsApp Cloud API webhook
# Valor arbitrario que voce escolhe e cadastra tambem no painel da Meta ao configurar o webhook
META_WEBHOOK_VERIFY_TOKEN=
# App Secret do App na Meta, usado para validar a assinatura X-Hub-Signature-256 de cada evento recebido
META_APP_SECRET=

# TEMPORARIO: so usar enquanto META_APP_SECRET nao existe, pra testar o
# fluxo sem validar assinatura. Remover assim que o App Secret real for
# configurado. NAO deixar "true" em producao com dado de cliente real.
ALLOW_UNSIGNED_WEBHOOK_TEMP=
